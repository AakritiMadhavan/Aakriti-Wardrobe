# Copy this file to .env for running on your own computer.
# On Render you set these in the dashboard instead (see README.md).

# Neon connection string (Neon dashboard > Connect). It ends with ?sslmode=require
# For a local Postgres: postgres://wardrobe:wardrobe@localhost:5432/wardrobe
DATABASE_URL=postgres://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Password for the admin page (open /#admin). Choose a long one.
ADMIN_PASSWORD=change-me-please

# Random string used to sign the admin login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional
PORT=3000
# Cookies are marked secure automatically when NODE_ENV=production (as on Render).
COOKIE_SECURE=false
